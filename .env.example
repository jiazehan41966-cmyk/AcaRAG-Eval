ENVIRONMENT=dev
DEFAULT_CHUNK_SIZE=600
DEFAULT_CHUNK_OVERLAP=120
DEFAULT_TOP_K=5
EMBEDDING_DIM=384

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=paper_chunks
QDRANT_PREFER_GRPC=false
QDRANT_FALLBACK_LOCAL=true
QDRANT_LOCAL_PATH=data/index/qdrant_local

EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5
RERANKER_MODEL_NAME=BAAI/bge-reranker-base
FORCE_MOCK_EMBEDDING=false

LLM_PROVIDER=none
LLM_MODEL_NAME=gpt-4o-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=

DEFAULT_GOLDEN_SET_PATH=data/golden_set/golden_set.jsonl
ENABLE_RAGAS=false
ENABLE_DEEPEVAL=false

MCP_MODE=inprocess
MCP_SERVER_URL=http://127.0.0.1:8765/mcp
MCP_TIMEOUT_SECONDS=15

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_TRACING_ENABLED=true
